{
  "name": "secure-vault-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "demo": "vite --mode demo --host 127.0.0.1 --port 3000",
    "build:demo": "vite build --mode demo",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 3000",
    "test:demo": "playwright test --config playwright.demo.config.js",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
